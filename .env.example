# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-turbo  # or gpt-35-turbo
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=ragstorage
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key-here
AZURE_STORAGE_CONTAINER_NAME=documents

# Azure Cognitive Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key
AZURE_SEARCH_INDEX_NAME=rag-documents

# Vector Store Configuration
VECTOR_STORE_TYPE=azure_search  # Options: azure_search, chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_CHUNKS=5

# LLM Configuration
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# Logging Configuration
LOG_LEVEL=INFO

# HuggingFace Configuration (Optional)
USE_HUGGINGFACE_EMBEDDINGS=false
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_TOKEN=your-hf-token-if-using-private-models

# Application Environment
ENVIRONMENT=production  # Options: development, staging, production
DEBUG=false
